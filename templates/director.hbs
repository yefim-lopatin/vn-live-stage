<div class="vn-director">
  <header class="vn-director-hero {{#if isPreparing}}is-preparing{{/if}} {{#if isLive}}is-live{{/if}}">
    <div>
      <span class="vn-director-eyebrow">РЕЖИМ СЦЕНЫ</span>
      {{#if isInactive}}<h1>Сцена выключена</h1>{{/if}}
      {{#if isPreparing}}<h1>Приватная подготовка</h1>{{/if}}
      {{#if isLive}}<h1>Сцена показана игрокам</h1>{{/if}}
      <p>{{state.scene.name}}</p>
    </div>
    <div class="vn-director-state-actions">
      {{#if isInactive}}<button type="button" class="vn-director-live" data-action="prepare-stage"><i class="fa-solid fa-hammer"></i> Подготовить сцену</button>{{/if}}
      {{#if isPreparing}}
        <button type="button" class="vn-director-live" data-action="publish-stage"><i class="fa-solid fa-tower-broadcast"></i> Показать игрокам</button>
        <button type="button" data-action="end-stage"><i class="fa-solid fa-xmark"></i> Закрыть</button>
      {{/if}}
      {{#if isLive}}
        <button type="button" class="vn-director-live" data-action="return-to-preparation"><i class="fa-solid fa-eye-slash"></i> Вернуть в подготовку</button>
        <button type="button" data-action="end-stage"><i class="fa-solid fa-stop"></i> Завершить</button>
      {{/if}}
    </div>
  </header>

  <section class="vn-director-section">
    <div class="vn-director-section-title">
      <h2>Текущая сцена</h2>
      <div class="vn-director-actions">
        <button type="button" data-action="new-scene" title="Новая пустая сцена"><i class="fa-solid fa-file-circle-plus"></i></button>
        <button type="button" data-action="save" title="Обновить текущую сцену"><i class="fa-solid fa-floppy-disk"></i></button>
        <button type="button" data-action="undo" title="Отменить"><i class="fa-solid fa-rotate-left"></i></button>
        <button type="button" data-action="redo" title="Повторить"><i class="fa-solid fa-rotate-right"></i></button>
      </div>
    </div>
    <div class="vn-director-two-columns">
      <label>Название <input name="scene-name" type="text" value="{{state.scene.name}}" placeholder="Таверна"></label>
      <label>Время <input name="scene-time" type="text" value="{{state.scene.time}}" placeholder="Вечер"></label>
    </div>
    <label>Подпись / погода <input name="scene-weather" type="text" value="{{state.scene.weather}}" placeholder="Дождь, праздник, тревога…"></label>
    <button type="button" class="vn-director-secondary" data-action="set-scene-details">Применить название и подпись</button>

    <label class="vn-director-label vn-director-spaced">Фон сцены</label>
    <div class="vn-director-field-row">
      <input name="background" type="text" value="{{state.scene.background}}" placeholder="Путь к изображению">
      <button type="button" data-action="browse-background" title="Выбрать файл"><i class="fa-solid fa-folder-open"></i></button>
      <button type="button" data-action="set-background">Применить</button>
    </div>
  </section>

  <section class="vn-director-section">
    <div class="vn-director-section-title">
      <h2>Участники</h2>
      <button type="button" class="vn-director-avatar-button" data-action="add-player-avatars">
        <i class="fa-solid fa-users"></i> Из аватаров игроков{{#if playerAvatarCount}} · {{playerAvatarCount}}{{/if}}
      </button>
    </div>
    <div class="vn-director-add-grid">
      <input name="portrait-name" type="text" placeholder="Имя персонажа">
      <div class="vn-director-field-row vn-director-image-field">
        <input name="portrait-image" type="text" placeholder="Путь к портрету">
        <button type="button" data-action="browse-portrait" title="Выбрать файл"><i class="fa-solid fa-folder-open"></i></button>
      </div>
      <button type="button" class="vn-director-primary" data-action="add-portrait"><i class="fa-solid fa-plus"></i> Добавить</button>
    </div>

    {{#if hasPortraits}}
      <div class="vn-director-cast">
        {{#each portraits}}
          <article class="vn-director-cast-item">
            {{#if image}}<img src="{{image}}" alt="">{{else}}<div class="vn-director-avatar"><i class="fa-solid fa-user"></i></div>{{/if}}
            <div><strong>{{name}}</strong><small>{{#if isLeft}}Слева · игрок{{else}}Справа · NPC{{/if}}{{#if flipped}} · отражён{{/if}}</small></div>
            <button type="button" data-action="flip-portrait" data-portrait-id="{{id}}" data-flipped="{{flipped}}" title="Отразить по горизонтали"><i class="fa-solid fa-arrows-left-right"></i></button>
            <button type="button" data-action="remove-portrait" data-portrait-id="{{id}}" title="Убрать"><i class="fa-solid fa-trash"></i></button>
          </article>
        {{/each}}
      </div>
    {{else}}
      <p class="vn-director-empty">Добавьте игроков из назначенных им персонажей или создайте NPC вручную.</p>
    {{/if}}
  </section>

  <details class="vn-director-library" open>
    <summary><span><i class="fa-solid fa-clapperboard"></i> Заготовленные сцены</span><small>{{scenes.length}}</small></summary>
    <div class="vn-director-library-body">
      <div class="vn-director-field-row">
        <input name="preset-name" type="text" placeholder="Название заготовки">
        <button type="button" data-action="save-preset"><i class="fa-solid fa-plus"></i> Сохранить текущую</button>
      </div>
      {{#if hasScenes}}
        <div class="vn-director-presets">
          {{#each scenes}}
            <article class="vn-director-preset">
              {{#if hasBackground}}<img src="{{background}}" alt="">{{else}}<div class="vn-director-preset-empty"><i class="fa-solid fa-image"></i></div>{{/if}}
              <div><strong>{{name}}</strong><small>{{portraitCount}} участников{{#if time}} · {{time}}{{/if}}</small></div>
              <button type="button" data-action="load-preset" data-scene-id="{{id}}">Загрузить</button>
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="vn-director-empty">Сохраните текущую композицию — фон, подпись и участники попадут в заготовку.</p>
      {{/if}}
    </div>
  </details>

  <details class="vn-director-library" open>
    <summary><span><i class="fa-solid fa-user-group"></i> Группы участников</span><small>{{groups.length}}</small></summary>
    <div class="vn-director-library-body">
      <div class="vn-director-field-row">
        <input name="group-name" type="text" placeholder="Например: Игроки или Стража">
        <button type="button" data-action="save-group"><i class="fa-solid fa-plus"></i> Создать из текущих</button>
      </div>
      {{#if hasGroups}}
        <div class="vn-director-groups">
          {{#each groups}}
            <article class="vn-director-group">
              <div><strong>{{name}}</strong><small>{{portraitCount}} участников</small></div>
              <button type="button" data-action="apply-group" data-group-id="{{id}}">Добавить в сцену</button>
            </article>
          {{/each}}
        </div>
      {{else}}
        <p class="vn-director-empty">Соберите участников текущей сцены и сохраните их как повторно используемую группу.</p>
      {{/if}}
    </div>
  </details>
</div>
