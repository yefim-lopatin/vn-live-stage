<div id="vn-live-stage-overlay" class="vn-cinematic-overlay {{#if isGM}}is-gm-preview{{/if}}" role="region" aria-label="Режим сцены">
  <div class="vn-cinematic-background {{#unless backgroundVisible}}is-hidden{{/unless}}" {{#if background}}style="background-image: url('{{background}}')"{{/if}}></div>
  <div class="vn-cinematic-vignette"></div>
  <div class="vn-cinematic-bar vn-cinematic-bar-top"></div>
  <div class="vn-cinematic-bar vn-cinematic-bar-bottom"></div>

  <header class="vn-cinematic-caption">
    <span data-vn-caption-name>{{state.scene.name}}</span>
    <small data-vn-caption-meta hidden>{{state.scene.time}}{{#if state.scene.weather}} · {{state.scene.weather}}{{/if}}</small>
  </header>

  <section class="vn-cinematic-side vn-cinematic-left" style="--vn-side-columns: {{sideColumns}}" aria-label="Персонажи слева">
    {{#each leftPortraits}}
      <figure class="vn-cinematic-portrait {{#if speaking}}is-speaking{{/if}} {{#if flipped}}is-flipped{{/if}} {{#if overflow}}is-overflow{{/if}}" data-portrait-id="{{id}}" style="--vn-slot: {{slot}}">
        {{#if hasImage}}<img data-portrait-image src="{{image}}" alt="{{name}}">{{else}}<div class="vn-cinematic-placeholder"><i class="fa-solid fa-user"></i></div>{{/if}}
        <div class="vn-cinematic-portrait-actions">
          {{#if ../isGM}}
            <button type="button" class="vn-cinematic-portrait-speak" data-action="portrait-speak" data-portrait-id="{{id}}"><i class="fa-solid fa-comment-dots"></i><span>Говорить</span></button>
            <button type="button" class="vn-cinematic-portrait-side" data-action="toggle-portrait-side" data-portrait-id="{{id}}" data-side="{{side}}" title="Перенести вправо"><i class="fa-solid fa-arrow-right"></i></button>
            <button type="button" class="vn-cinematic-portrait-flip" data-action="flip-portrait" data-portrait-id="{{id}}" data-flipped="{{flipped}}" title="Отразить портрет"><i class="fa-solid fa-arrows-left-right"></i></button>
            <button type="button" class="vn-cinematic-portrait-remove" data-action="remove-portrait" data-portrait-id="{{id}}" title="Убрать персонажа"><i class="fa-solid fa-trash"></i></button>
          {{else}}
            {{#if ownedByCurrentUser}}<button type="button" class="vn-cinematic-portrait-speak" data-action="portrait-speak" data-player-speak="true" data-portrait-id="{{id}}"><i class="fa-solid fa-comment-dots"></i><span>Зажать, чтобы говорить</span></button>{{/if}}
          {{/if}}
        </div>
        <figcaption data-portrait-name>{{name}}</figcaption>
      </figure>
    {{/each}}
  </section>

  <section class="vn-cinematic-side vn-cinematic-right" style="--vn-side-columns: {{sideColumns}}" aria-label="Персонажи справа">
    {{#each rightPortraits}}
      <figure class="vn-cinematic-portrait {{#if speaking}}is-speaking{{/if}} {{#if flipped}}is-flipped{{/if}} {{#if overflow}}is-overflow{{/if}}" data-portrait-id="{{id}}" style="--vn-slot: {{slot}}">
        {{#if hasImage}}<img data-portrait-image src="{{image}}" alt="{{name}}">{{else}}<div class="vn-cinematic-placeholder"><i class="fa-solid fa-user"></i></div>{{/if}}
        <div class="vn-cinematic-portrait-actions">
          {{#if ../isGM}}
            <button type="button" class="vn-cinematic-portrait-speak" data-action="portrait-speak" data-portrait-id="{{id}}"><i class="fa-solid fa-comment-dots"></i><span>Говорить</span></button>
            <button type="button" class="vn-cinematic-portrait-side" data-action="toggle-portrait-side" data-portrait-id="{{id}}" data-side="{{side}}" title="Перенести влево"><i class="fa-solid fa-arrow-left"></i></button>
            <button type="button" class="vn-cinematic-portrait-flip" data-action="flip-portrait" data-portrait-id="{{id}}" data-flipped="{{flipped}}" title="Отразить портрет"><i class="fa-solid fa-arrows-left-right"></i></button>
            <button type="button" class="vn-cinematic-portrait-remove" data-action="remove-portrait" data-portrait-id="{{id}}" title="Убрать персонажа"><i class="fa-solid fa-trash"></i></button>
          {{else}}
            {{#if ownedByCurrentUser}}<button type="button" class="vn-cinematic-portrait-speak" data-action="portrait-speak" data-player-speak="true" data-portrait-id="{{id}}"><i class="fa-solid fa-comment-dots"></i><span>Зажать, чтобы говорить</span></button>{{/if}}
          {{/if}}
        </div>
        <figcaption data-portrait-name>{{name}}</figcaption>
      </figure>
    {{/each}}
  </section>

  {{#if isGM}}
    <div class="vn-cinematic-gm-actions">
      {{#if isPreparing}}<button type="button" data-action="publish-stage" title="Показать сцену игрокам"><i class="fa-solid fa-tower-broadcast"></i><span>Показать игрокам</span></button>{{/if}}
      {{#if isLive}}<button type="button" data-action="return-to-preparation" title="Скрыть сцену от игроков"><i class="fa-solid fa-eye-slash"></i><span>В подготовку</span></button>{{/if}}
      {{#if background}}<button type="button" data-action="toggle-background" data-visible="{{backgroundVisible}}" title="{{#if backgroundVisible}}Скрыть фоновую картинку{{else}}Показать фоновую картинку{{/if}}"><i class="fa-solid {{#if backgroundVisible}}fa-eye-slash{{else}}fa-eye{{/if}}"></i><span>{{#if backgroundVisible}}Скрыть фон{{else}}Показать фон{{/if}}</span></button>{{/if}}
      <button type="button" data-action="open-director" title="Открыть пульт"><i class="fa-solid fa-sliders"></i><span>Пульт</span></button>
      <button type="button" data-action="end-stage" title="Завершить сцену"><i class="fa-solid fa-stop"></i><span>Завершить</span></button>
    </div>
    {{#if hasQuickLibrary}}
      <aside class="vn-cinematic-library" aria-label="Быстрые заготовки">
        {{#if quickScenes.length}}
          <section>
            <h2><i class="fa-solid fa-clapperboard"></i> Сцены</h2>
            <div class="vn-cinematic-library-list">
              {{#each quickScenes}}
                <article class="vn-cinematic-library-item">
                  <button type="button" class="vn-cinematic-library-main" data-action="quick-load-scene" data-scene-id="{{id}}">
                    <strong>{{name}}</strong><small>{{portraitCount}} участников</small>
                  </button>
                  <button type="button" class="vn-cinematic-library-delete" data-action="quick-delete-scene" data-scene-id="{{id}}" title="Удалить сцену"><i class="fa-solid fa-trash"></i></button>
                </article>
              {{/each}}
            </div>
          </section>
        {{/if}}
        {{#if quickGroups.length}}
          <section>
            <h2><i class="fa-solid fa-user-group"></i> Персонажи</h2>
            <div class="vn-cinematic-library-list">
              {{#each quickGroups}}
                <article class="vn-cinematic-library-item">
                  <button type="button" class="vn-cinematic-library-main" data-action="quick-apply-group" data-group-id="{{id}}">
                    <strong>{{name}}</strong><small>{{#if participantNames}}{{participantNames}}{{else}}{{portraitCount}} участников{{/if}}</small>
                  </button>
                  <button type="button" class="vn-cinematic-library-delete" data-action="quick-delete-group" data-group-id="{{id}}" title="Удалить группу"><i class="fa-solid fa-trash"></i></button>
                </article>
              {{/each}}
            </div>
          </section>
        {{/if}}
      </aside>
    {{/if}}
  {{/if}}

  {{#unless isGM}}
    {{#if canJoinStage}}
      <button type="button" class="vn-cinematic-player-join" data-action="join-stage" title="Добавить своего персонажа к диалогу"><i class="fa-solid fa-user-plus"></i><span>Присоединиться к диалогу</span></button>
    {{/if}}
  {{/unless}}

  {{#if canLeaveStage}}
    <button type="button" class="vn-cinematic-leave" data-action="leave-stage" title="Убрать своего персонажа со сцены"><i class="fa-solid fa-right-from-bracket"></i><span>Выйти из диалога</span></button>
  {{/if}}
</div>
